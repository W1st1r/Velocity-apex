{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "velocity-apex",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  }
}
